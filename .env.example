# ─────────────────────────────────────────────────────────────────────────────
# Elroy — copy to .env and fill in.  (Vercel users: same names go in Project → Env Vars.)
# Lines marked REQUIRED must be set. Everything else is optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── VPS / Docker only ────────────────────────────────────────────────────────
# Domain pointing at this server (A record). Caddy gets the HTTPS cert for it.
# REQUIRED (Docker)
ELROY_DOMAIN=elroy.example.com
# Any long random string; shared by the app and the local Redis REST shim.
# REQUIRED (Docker)
REDIS_REST_TOKEN=change-me-to-a-long-random-string
# Where the headless listener gets audio: "twitch" (zero setup, a few seconds behind live)
# or an ffmpeg URL such as srt://0.0.0.0:9000?mode=listener fed by OBS (near real-time).
LISTEN_SOURCE=twitch
# Set false to only do "is the host talking" detection (no OpenAI transcription cost).
LISTEN_TRANSCRIBE=true
# Seconds per transcript clip (3-15). 5 makes on-screen captions show up sooner; costs more OpenAI requests.
LISTEN_CHUNK_SECONDS=10

# ── Voice pacing ─────────────────────────────────────────────────────────────
# liberal = talks much more often with shorter spoken lines; normal; conservative.
# Credit tiers still apply: as the ElevenLabs balance drops, he slows down automatically.
ELROY_VOICE_PACE=normal
# true = Elroy stops mid-sentence when you start talking. Only turn on when the listener
# hears your MIC ALONE (SRT from OBS with a mic-only track) — see the setup guide.
ELROY_VOICE_BARGE_IN=false

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED — channel login, no #
NEXT_PUBLIC_TWITCH_CHANNEL=dtldabs
# REQUIRED — long random string; used in /embed/<secret> and /control/<secret>
ELROY_CONTROL_SECRET=
NEXT_PUBLIC_STREAMER_DISPLAY_NAME=DTLDabs

# Twitch app (dev.twitch.tv/console)
# REQUIRED
TWITCH_CLIENT_ID=
# REQUIRED
TWITCH_CLIENT_SECRET=
# Bot account token: chat:read + chat:edit (or user:write:chat). Mod the bot in your channel.
# REQUIRED
TWITCH_BOT_OAUTH_TOKEN=
# Optional safety check: Elroy refuses to post if the token belongs to a different account.
TWITCH_BOT_USERNAME=
# Broadcaster token (log in as the channel owner): chat:read, chat:edit, moderator:read:followers,
# channel:manage:polls, clips:edit, moderator:manage:announcements, moderator:manage:shoutouts,
# bits:read — plus channel:read:redemptions for the Roast Me / Ask Elroy rewards.
# REQUIRED
TWITCH_OAUTH_TOKEN=
TWITCH_BROADCASTER_LOGIN=
# 10-100 chars; signs EventSub webhooks (raids, subs, follows, power-ups).
TWITCH_EVENTSUB_SECRET=
# Leave blank on Docker — derived from ELROY_DOMAIN. Set on Vercel if not using VERCEL_URL.
TWITCH_EVENTSUB_CALLBACK=

# Brain + voice
# REQUIRED
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=
# REQUIRED
ELEVENLABS_API_KEY=
# REQUIRED
ELEVENLABS_VOICE_ID=
# Optional persona override (defaults to the built-in OG Elroy prompt).
SYSTEM_PROMPT=

# Studio / listener transcription (host speech → "hey Elroy")
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
# The same OpenAI key is Elroy's backup brain when Gemini's quota runs out (only used then).
# Who answers first: gemini (default) or openai. The other one is the automatic backup.
ELROY_BRAIN=
ELROY_OPENAI_MODEL=

# Spotify now-playing
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Leave blank on Docker — derived from ELROY_DOMAIN. Must match the Spotify app's redirect URI.
SPOTIFY_REDIRECT_URI=

# Channel-point rewards (both need "Require viewer to enter text").
# Auto-detected by title ("Roast Me", "Ask Elroy") when TWITCH_OAUTH_TOKEN has channel:read:redemptions.
ELROY_REWARD_ROAST_ID=
ELROY_REWARD_ASK_ID=

# Monthly trivia season timezone
ELROY_TIMEZONE=America/New_York

# Trivia
TRIVIA_DISABLE_GEMINI=
TRIVIA_ADMIN_SECRET=

# ── Vercel only (Docker sets these itself) ──────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
